# Ambiente
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
TIMEZONE=America/Sao_Paulo

# Credenciais administrativas iniciais
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=Admin123!
DEV_USER_EMAIL=dev@example.com

# Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whats_atende
DB_USERNAME=root
DB_PASSWORD=

# Logs & Observabilidade
LOG_CHANNEL=file,db
LOG_LEVEL=info

# Integração Evolution API
EVO_API_BASE=http://localhost:8080
EVO_INSTANCE=W001
EVO_API_KEY=changeme
EVO_TOKEN=

# Webhook Evolution
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_HMAC_SECRET=

# Execução assíncrona & tempo real
REALTIME_DRIVER=sse
QUEUE_DRIVER=database

# Feature Flags
FEATURE_FLAGS=ai,liveops,capacity,kb,pii

# Outros ajustes
INTEGRATION_MODE=webhook
