{
    "name": "whatsatende/whatsatende",
    "description": "Sistema de atendimento via chat",
    "type": "project",
    "require": {
        "php-di/php-di": "^7.1",
        "nikic/fast-route": "^1.3",
        "illuminate/database": "^13.17",
        "phpoption/phpoption": "^1.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
